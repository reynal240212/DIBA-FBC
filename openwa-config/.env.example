# ============================================================
# DIBA FBC - OpenWA Server Configuration
# ============================================================
# Copiar este archivo como .env en la carpeta de OpenWA
# y ajustar las variables según el entorno de despliegue.

# Server
PORT=2785
NODE_ENV=production

# WhatsApp Engine
ENGINE_TYPE=whatsapp-web.js
PUPPETEER_HEADLESS=true

# Database (SQLite for single-session, or PostgreSQL)
DATABASE_TYPE=sqlite
# DATABASE_TYPE=postgres
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=openwa_diba
# POSTGRES_USER=openwa
# POSTGRES_PASSWORD=CHANGE_ME

# Session persistence
SESSION_DATA_PATH=./data/sessions

# Storage
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./data/storage

# API Security
API_MASTER_KEY=CHANGE_ME_TO_A_SECURE_KEY

# CORS (allow DIBA FBC admin panel)
CORS_ORIGINS=https://dibafbc.vercel.app,http://localhost:3000,http://localhost:5173

# Webhook (for incoming message processing)
# Set this to your serverless function endpoint or leave empty
# WEBHOOK_URL=https://your-project.vercel.app/api/whatsapp-webhook

# Disable heavy features for lightweight setup
REDIS_ENABLED=false
QUEUE_ENABLED=false
CACHE_ENABLED=false
SEARCH_ENABLED=false
MCP_ENABLED=false
